[run]
source = apps
omit =
    */migrations/*
    */tests/*
    */test_*.py
    setup.py
    conftest.py
    manage.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    class .*\(Protocol\):
    if 0:
    if False:

precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
